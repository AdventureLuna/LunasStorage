# The local server reads Windows process environment variables, not this file.
# By default SQLite and photos live in this project's data/ folder (ignored by Git).
# Optional PowerShell configuration before start.bat:
# $env:INVENTORY_PORT = '8000'
# $env:INVENTORY_DATA_DIR = 'D:\LunasStorageData'
# The frontend always uses relative /api URLs. No frontend credentials are used.
